# ============ AURAFLEX configuration ============
# Copy this file to `.env` and fill in your own key.
# Get a free TMDB v3 API key: https://www.themoviedb.org/settings/api

TMDB_API_KEY=your_tmdb_v3_api_key_here

# Optional: alternate Vidsrc hosts, comma separated
VIDSRC_HOSTS=vidsrc.to,vidsrc.cc
